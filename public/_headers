# Response headers for proreadyengineer.com (Cloudflare Pages).
#
# /assets/* is safe to cache for a year: Vite puts a hash of the content in
# every file name there, so a changed file is a new name and a returning
# visitor downloads nothing twice.
#
# /img/* (the light image copies) keeps its name when the artwork behind it is
# replaced, so it is cached for a day only; after that the browser checks, and
# is told "unchanged" without downloading again.
#
# Pages and everything else keep Cloudflare's default "always revalidate", so a
# new release shows at once.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400

# Ask browsers to use HTTPS only, and keep the site out of other sites' frames
# (the learner portal and admin live on this origin).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN

# Pro3DWorks download is a qualified offline application, not a web page.
# Preserve the exact artifact: disable CDN HTML/email/analytics rewriting.
# Cover both Pages' canonical extensionless route and the public .html link.
/downloads/Pro3DWorks
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Pro3DWorks.html"
  Cache-Control: public, no-transform

/downloads/Pro3DWorks.html
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Pro3DWorks.html"
  Cache-Control: public, no-transform
